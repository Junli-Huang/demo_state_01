    "objectsFolderStructure": { "folderName": "__ROOT", "children": [] },
    "events": [{
      "type": "BuiltinCommonInstructions::JsCode",
      "inlineCode": [
        "// Native GDevelop objects + instance variables. This event only dispatches the V0.3 rule loop.",
        "const dt = runtimeScene.getElapsedTime() / 1000;",
        "const entities = runtimeScene.getObjects('Entity');",
        "const read = (v, ...path) => path.slice(1).reduce((p,key) => p == null ? undefined : p[key], v.get(path[0]).toJSObject());",
        "const write = (v, value, ...path) => { const root=v.get(path[0]), data=root.toJSObject()||{}; let p=data; for(let i=1;i<path.length-1;i++) p=p[path[i]]||(p[path[i]]={}); p[path[path.length-1]]=value; root.fromJSObject(data); };",
        "const num = (v, ...path) => Number(read(v, ...path)||0);",
        "const setNum = (v, value, ...path) => write(v, value, ...path);",
        "const bool = (v, ...path) => Boolean(read(v, ...path));",
        "const setBool = (v, value, ...path) => write(v, value, ...path);",
        "const overlaps = (a, b) => Math.abs(a.getCenterXInScene()-b.getCenterXInScene()) < 88 && Math.abs(a.getCenterYInScene()-b.getCenterYInScene()) < 88;",
        "const influence = new Map(entities.map(e => [e, {Fire:0,Water:0,Ice:0,Poison:0}]));",
        "for (let i=0; i<entities.length; i++) for (let j=i+1; j<entities.length; j++) {",
        "  const a=entities[i], b=entities[j]; if (!overlaps(a,b)) continue;",
        "  const av=a.getVariables(), bv=b.getVariables();",
        "  for (const k of ['Fire','Water','Ice','Poison']) { influence.get(a)[k]+=num(bv,'Attributes',k); influence.get(b)[k]+=num(av,'Attributes',k); }",
        "}",
        "const responses={Fire:'Burning',Water:'Wet',Ice:'Frozen',Poison:'Poisoned'};",
        "for (const e of entities) {",
        "  const v=e.getVariables();",
        "  for (const [attribute,state] of Object.entries(responses)) {",
        "    const active=bool(v,'States',state,'Active'), strength=influence.get(e)[attribute];",
        "    if (!active && strength>0) { const next=Math.min(100,num(v,'States',state,'EnterProgress')+strength*20*dt); setNum(v,next,'States',state,'EnterProgress'); if(next>=100){setBool(v,true,'States',state,'Active');setNum(v,0,'States',state,'ExitProgress');setNum(v,0,'States',state,'ActiveDuration');} }",
        "    else if (active && strength<=0) { const next=Math.min(100,num(v,'States',state,'ExitProgress')+20*dt); setNum(v,next,'States',state,'ExitProgress'); if(next>=100){setBool(v,false,'States',state,'Active');setNum(v,0,'States',state,'EnterProgress');setNum(v,0,'States',state,'InactiveDuration');} }",
        "    else if (active && strength>0) setNum(v,Math.max(0,num(v,'States',state,'ExitProgress')-strength*20*dt),'States',state,'ExitProgress');",
        "    if (bool(v,'States',state,'Active')) { setNum(v,num(v,'States',state,'ActiveDuration')+dt,'States',state,'ActiveDuration'); setNum(v,0,'States',state,'InactiveDuration'); }",
        "    else { setNum(v,num(v,'States',state,'InactiveDuration')+dt,'States',state,'InactiveDuration'); setNum(v,0,'States',state,'ActiveDuration'); }",
        "  }",
        "  const burning=bool(v,'States','Burning','Active'), granted=bool(v,'States','Burning','Granted');",
        "  if (burning && !granted && num(v,'States','Burning','ActiveDuration')>=5) { setNum(v,num(v,'Attributes','Fire')+1,'Attributes','Fire'); setBool(v,true,'States','Burning','Granted'); }",
        "  if (!burning && granted && num(v,'States','Burning','InactiveDuration')>=10) { setNum(v,Math.max(0,num(v,'Attributes','Fire')-1),'Attributes','Fire'); setBool(v,false,'States','Burning','Granted'); }",
        "}"
      ],
      "parameterObjects": "",
      "useStrict": true,
      "eventsSheetExpanded": true
    }],
